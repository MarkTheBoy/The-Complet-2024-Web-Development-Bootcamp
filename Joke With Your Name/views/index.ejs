<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Joke with your name</title>
</head>
<body>
    <form action="/search" method="GET">
        <input type="text" name="query" placeholder="Search for a joke">
        <button type="submit">Search</button>
    </form>
    <% if (typeof joke !== 'undefined') { %>
        <p><%= joke %></p>
    <% } %>
</body>
</html>